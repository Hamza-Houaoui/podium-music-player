<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Online music (D-34, D-38): catalogue requests and artwork, https only (NetworkPolicy and the
         platform's cleartext switch agree since the user-server sources were retired). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Podium's own updates (D-99): a release downloaded from GitHub, handed to Android's installer
         (which asks the listener to confirm) once it's checked to be this app, signed by the same key. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Remote playback (YOUTUBE_MUSIC_ARCHITECTURE §8): Podium needs to see whether the app that
         plays online songs is installed, and to open it on a song. -->
    <queries>
        <package android:name="com.google.android.apps.youtube.music" />
    </queries>

    <application
        android:name=".PodiumApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Podium"
        android:supportsRtl="true"
        android:theme="@style/Theme.Podium">

        <!-- Portrait only (D-108): Podium is a device you hold upright in one hand, and it has no
             landscape arrangement to turn into. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Open audio files directly from file managers and other apps. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/flac" />
                <data android:mimeType="application/x-flac" />
            </intent-filter>

            <!-- Open YouTube Music and YouTube song/playlist links in Podium. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="music.youtube.com" />
                <data android:host="www.youtube.com" />
                <data android:host="youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:host="youtu.be" />
            </intent-filter>

            <!-- Receive shared YouTube Music / YouTube links or audio files. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- Signing in on the online service's own page (§6); never started from outside Podium.
             Turning, folding or resizing the phone keeps the page (and anything typed into it). -->
        <activity
            android:name=".WebSignInActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- What Android's installer says about an update (D-99); only the installer's own intent reaches it. -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />
    </application>
</manifest>
